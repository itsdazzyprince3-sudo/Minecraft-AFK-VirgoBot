{
  "name": "Virgo Ollama AI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash scripts/codespace-ai.sh install",
  "postStartCommand": "bash scripts/codespace-ai.sh start; bash scripts/codespace-keepalive.sh start",
  "forwardPorts": [11434],
  "portsAttributes": {
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
